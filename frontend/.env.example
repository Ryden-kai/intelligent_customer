# Frontend build-time configuration. Anything starting with VITE_ is
# embedded into the bundle and is visible to the browser.

# Absolute base URL of the Go backend, including scheme but no trailing
# slash. Leave empty when serving the SPA behind the same origin as the
# backend (i.e. the backend's own reverse proxy serves /api).
# Production example:
#   VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=

# Override where `vite dev` proxies /api to. Default is http://localhost:8080.
VITE_API_PROXY_TARGET=http://localhost:8080

# HMAC shared secret with the backend. MUST match JWT_SECRET on the
# server when SIGNATURE_REQUIRED=true. The frontend ALWAYS attaches
# signature headers — production builds should override this with the
# real production JWT_SECRET. The default below is a stable dev secret
# intended for `npm run dev` against a local backend that has the same
# JWT_SECRET; if your backend uses a different JWT_SECRET, set this in
# frontend/.env to match (and keep frontend/.env out of git).
VITE_API_SIGN_SECRET=dev-secret-please-change-in-production-must-be-32b