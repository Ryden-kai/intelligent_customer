# ====== Server ======
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# ====== Logging ======
# 开发期默认 debug，控制台带颜色；上线后改为 info + LOG_PRETTY=false
LOG_LEVEL=debug
LOG_PRETTY=true

# ====== SQLite ======
DB_PATH=./data/intelligent_customer.db

# ====== JWT / HMAC / AES key =====
# 32+ 字节随机字符串；生产请用 openssl rand -hex 32。
# 这个值同时承担三重职责：
#   1) JWT 签名密钥
#   2) HMAC-SHA256 请求签名密钥（与前端 VITE_API_SIGN_SECRET 同值）
#   3) AES-256-GCM 加密 key 的 HKDF 派生源
# 前端开发期默认 secret = "dev-secret-please-change-in-production-must-be-32b"，
# 这里默认填同样的字符串，方便 npm run dev 直接联调。
JWT_SECRET=dev-secret-please-change-in-production-must-be-32b
JWT_TTL_HOURS=24

# ====== Admin (bootstrap only) ======
# These two values are used ONLY the first time the server boots into an
# empty admin_users table — they hash the password with Argon2id and insert
# the row. After that, manage accounts via `adminctl` (see backend/README.md)
# and feel free to blank these out so the plaintext never lives on disk.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ====== LLM: pick provider ======
#   provider = "openai"      -> uses OPENAI_* below
#   provider = "MiniMax"     -> uses MiniMax_* below (中国版)
LLM_PROVIDER=MiniMax

# --- OpenAI-compatible ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- MiniMax cn (Anthropic-compatible) ---
# https://api.minimax.cn/anthropic (国内版，Token Plan 订阅)
# /v1/messages is the actual endpoint path. Model: MiniMax-M3.
# Note: the older api.minimaxi.cn (i) host is defunct — don't use it.
MiniMax_BASE_URL=https://api.minimax.cn/anthropic
MiniMax_MODEL=MiniMax-M3
MiniMax_API_KEY=
OPENAI_API_KEY=

# --- MiniMax (中国版) ---
MiniMax_BASE_URL=https://api.MiniMax.chat/v1
MiniMax_MODEL=MiniMax-M2
MiniMax_API_KEY=

# ====== Jev (OpenRouter Decisions API) ======
# Leave JEV_BASE_URL empty to fall back to LLM-only intent routing.
JEV_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.13
JEV_API_KEY=

# 转人工兜底阈值：confidence 低于此值且未命中 FAQ，则触发转人工
HANDOVER_CONFIDENCE_THRESHOLD=0.55
# 同一会话累计转人工信号次数阈值
MSG_HANDOVER_COUNT_THRESHOLD=3

# ====== CORS ======
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://localhost:8443

# ====== TLS (optional) ======
# 同时设置 TLS_CERT_FILE 与 TLS_KEY_FILE 后，server 会自动 ListenAndServeTLS；
# 留空则走 HTTP（开发用）。建议用 mkcert 生成自签证书：
#   mkcert -install && mkcert localhost 127.0.0.1 ::1
#   TLS_CERT_FILE=./certs/localhost+3.pem
#   TLS_KEY_FILE=./certs/localhost+3-key.pem
TLS_CERT_FILE=
TLS_KEY_FILE=

# ====== App-layer security ======
# 接口签名 / 防篡改（HMAC-SHA256 + 防重放）。生产强烈建议保持 true；
# 仅在本地用 curl 调试时可以临时关掉。
SIGNATURE_REQUIRED=true
SIGNATURE_CLOCK_SKEW=5m
SIGNATURE_NONCE_TTL=10m

# 应用层加密（AES-256-GCM）。敏感字段（消息正文、满意度评论）
# 在落库前加密、读出后解密。密钥用 HKDF-SHA256 从 JWT_SECRET 派生，
# 也可通过 ENCRYPTION_KEY_HEX 直接指定 32 字节 hex（64 hex 字符）来
# 与 JWT_SECRET 解耦、便于独立轮换。
ENCRYPT_SENSITIVE_FIELDS=true
ENCRYPTION_KEY_HEX=

# ====== v2.2 PR1 错误脱敏 ======
# 应用环境标识。生产环境（APP_ENV=production）启用 middleware.Sanitize：
#   - 5xx 响应统一返回 { code: "internal", message: "服务暂时不可用，请稍后再试", request_id }
#   - 不暴露 panic stack / SQL 错误细节 / 内部错误码
# 开发环境（默认 "development"）保留原始错误体 + stack，便于调试。
# 上线前必须改为 APP_ENV=production。
APP_ENV=development